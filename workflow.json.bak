    {
      "parameters": {
        "jsCode": "const envelope = $json;\nconst candidate = envelope && typeof envelope === 'object' && !Array.isArray(envelope)\n  ? (envelope.body ?? envelope)\n  : null;\n\nconst errors = [];\nif (!candidate || typeof candidate !== 'object' || Array.isArray(candidate)) {\n  errors.push('payload must be a JSON object');\n}\n\nconst body = candidate && typeof candidate === 'object' && !Array.isArray(candidate) ? candidate : {};\nconst limits = {\n  name: 120,\n  email: 254,\n  company: 160,\n  message: 5000,\n  budget: 120,\n  timeline: 120,\n  source: 120\n};\n\nconst normalize = (value) => value\n  .normalize('NFKC')\n  .replace(/[\\u0000-\\u001F\\u007F]/g, ' ')\n  .replace(/\\s+/g, ' ')\n  .trim();\n\nconst readString = (field, required = false) => {\n  const exists = Object.prototype.hasOwnProperty.call(body, field) && body[field] !== null;\n  if (!exists) {\n    if (required) errors.push(`${field} is required`);\n    return '';\n  }\n\n  if (typeof body[field] !== 'string') {\n    errors.push(`${field} must be a string`);\n    return '';\n  }\n\n  const value = normalize(body[field]);\n  if (required && !value) errors.push(`${field} is required`);\n  if (value.length > limits[field]) errors.push(`${field} exceeds ${limits[field]} characters`);\n  return value.slice(0, limits[field]);\n};\n\nlet serializedLength = 0;\ntry {\n  serializedLength = JSON.stringify(body).length;\n} catch (_) {\n  errors.push('payload must be JSON serializable');\n}\nif (serializedLength > 12000) errors.push('payload exceeds 12000 characters');\n\nconst lead = {\n  name: readString('name', true),\n  email: readString('email').toLowerCase(),\n  company: readString('company'),\n  message: readString('message', true),\n  budget: readString('budget'),\n  timeline: readString('timeline'),\n  source: readString('source')\n};\n\nif (lead.email && !/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(lead.email)) {\n  errors.push('email is invalid');\n}\n\nconst untrustedText = Object.values(lead).join(' ');\nconst injectionSignals = [\n  /ignore\\s+(all\\s+)?(previous|prior|above|earlier)\\s+(instructions?|messages?|rules?)/i,\n  /forget\\s+(all\\s+)?(previous|prior|above|earlier)\\s+(instructions?|messages?|rules?)/i,\n  /(reveal|show|print|repeat|expose)\\b.{0,40}\\b(system|developer)\\s+(prompt|message|instructions?)/i,\n  /act\\s+as\\s+(the\\s+)?(system|developer|administrator)/i,\n  /(override|bypass|disregard)\\b.{0,30}\\b(instructions?|rules?|policy)/i,\n  /(return|output|respond with)\\b.{0,60}\\binstead\\b/i,\n  /do\\s+not\\s+follow\\b.{0,40}\\b(instructions?|rules?)/i,\n  /prompt\\s*injection/i,\n  /jailbreak/i,\n  /<\\/?system>/i,\n  /\\[(system|developer)\\]/i,\n  /begin\\s+(system|developer)\\s+(prompt|message)/i\n];\nconst suspectedPromptInjection = injectionSignals.some((pattern) => pattern.test(untrustedText));\n\nreturn [{\n  json: {\n    valid: errors.length === 0,\n    errors: [...new Set(errors)],\n    lead,\n    security: { suspected_prompt_injection: suspectedPromptInjection },\n    request_id: String($execution?.id ?? ''),\n    received_at: new Date().toISOString()\n  }\n}];"
      },

    {
      "parameters": {
        "jsCode": "const raw = $json.output ?? $json;\nconst source = $(\"Validate and Normalize Input\").first().json;\nconst lead = source.lead ?? {};\n\nconst clampInt = (value, min, max) => {\n\tconst number = Number(value);\n\n\tif (!Number.isFinite(number)) {\n\t\treturn min;\n\t}\n\n\treturn Math.min(max, Math.max(min, Math.round(number)));\n};\n\nconst repairKnownSpacing = (value) => {\n\tlet text = value;\n\n\tconst replacements = [\n\t\t[/\\bandrouting\\b/gi, \"and routing\"],\n\t\t[/\\bwouldhelp\\b/gi, \"would help\"],\n\t\t[/\\bservicesprovided\\b/gi, \"services provided\"],\n\t\t[/\\bunsolicitedcommercial\\b/gi, \"unsolicited commercial\"],\n\t\t[/\\b15-minutediscovery\\b/gi, \"15-minute discovery\"],\n\t\t[/\\btheproject\\b/gi, \"the project\"],\n\t\t[/\\bmessagementions\\b/gi, \"message mentions\"],\n\t\t[/\\bprojecttimeline\\b/gi, \"project timeline\"],\n\t\t[/\\bmedicalrecords\\b/gi, \"medical records\"],\n\t\t[/\\bsupporttickets\\b/gi, \"support tickets\"],\n\t\t[/\\bcurrentsupport\\b/gi, \"current support\"],\n\t\t[/\\boutto\\b/gi, \"out to\"],\n\t];\n\n\tfor (const [pattern, replacement] of replacements) {\n\t\ttext = text.replace(pattern, replacement);\n\t}\n\n\treturn text;\n};\n\nconst cleanText = (value, maxLength) => {\n\tlet text = String(value ?? \"\");\n\n\ttext = text\n\t\t.replace(/<script\\b[^>]*>[\\s\\S]*?<\\/script>/gi, \" \")\n\t\t.replace(/<style\\b[^>]*>[\\s\\S]*?<\\/style>/gi, \" \")\n\t\t.replace(/<[^>]*>/g, \" \")\n\t\t.replace(/&nbsp;/gi, \" \")\n\t\t.replace(/&amp;/gi, \"&\")\n\t\t.replace(/&lt;/gi, \"<\")\n\t\t.replace(/&gt;/gi, \">\")\n\t\t.replace(/[\\u0000-\\u001F\\u007F]/g, \" \")\n\t\t.replace(/([.!?,;:])(?=[A-Za-z])/g, \"$1 \")\n\t\t.replace(/(\\d+-minute)(?=[A-Za-z])/gi, \"$1 \")\n\t\t.replace(/\\s+/g, \" \")\n\t\t.trim();\n\n\ttext = repairKnownSpacing(text);\n\n\treturn text.slice(0, maxLength);\n};\n\nconst limitWords = (value, maximumWords) => {\n\tconst words = cleanText(value, 2000).split(/\\s+/).filter(Boolean);\n\n\treturn words.slice(0, maximumWords).join(\" \");\n};\n\nconst breakdown = {\n\tservice_fit: clampInt(raw.service_fit_score, 0, 40),\n\tbudget_authority: clampInt(raw.budget_authority_score, 0, 25),\n\turgency: clampInt(raw.urgency_score, 0, 20),\n\trequirements_clarity: clampInt(raw.requirements_clarity_score, 0, 15),\n};\n\n/*\n * Correct unsupported budget and authority points.\n *\n * A blank, unknown, or unapproved budget is not usable evidence.\n * General company information does not prove purchasing authority.\n */\nif (lead && typeof lead === \"object\") {\n\tconst budgetText = cleanText(lead.budget, 120);\n\n\tconst authorityEvidenceText = cleanText(\n\t\t`${lead.message ?? \"\"} ${lead.timeline ?? \"\"}`,\n\t\t6000,\n\t);\n\n\tconst unusableBudgetPattern =\n\t\t/\\b(no budget|not approved|unapproved|not set|unknown|none|n\\/a|tbd|to be determined|not sure)\\b/i;\n\n\tconst hasUsableBudget =\n\t\tBoolean(budgetText) && !unusableBudgetPattern.test(budgetText);\n\n\tconst hasAuthorityEvidence =\n\t\t/\\b(i|we)\\s+(approve|approved|authorize|authorized|own|control|manage|decide|lead)\\b/i.test(\n\t\t\tauthorityEvidenceText,\n\t\t) ||\n\t\t/\\b(owner|founder|co-founder|ceo|cfo|cto|coo|director|head of|decision[- ]maker|budget owner|procurement lead|purchasing authority)\\b/i.test(\n\t\t\tauthorityEvidenceText,\n\t\t);\n\n\tif (!hasUsableBudget && !hasAuthorityEvidence) {\n\t\tbreakdown.budget_authority = 0;\n\t}\n}\n\nconst spamDetected = raw.spam_detected === true;\n\nif (spamDetected) {\n\tbreakdown.service_fit = 0;\n\tbreakdown.budget_authority = 0;\n\tbreakdown.urgency = 0;\n\tbreakdown.requirements_clarity = 0;\n}\n\nconst leadScore =\n\tbreakdown.service_fit +\n\tbreakdown.budget_authority +\n\tbreakdown.urgency +\n\tbreakdown.requirements_clarity;\n\nconst category = spamDetected\n\t? \"Spam\"\n\t: leadScore >= 80\n\t\t? \"Hot\"\n\t\t: leadScore >= 60\n\t\t\t? \"Warm\"\n\t\t\t: \"Cold\";\n\nlet confidence = clampInt(raw.confidence, 0, 100);\n\nconst submittedText = cleanText(\n\t[\n\t\tlead.name,\n\t\tlead.company,\n\t\tlead.message,\n\t\tlead.budget,\n\t\tlead.timeline,\n\t\tlead.source,\n\t].join(\" \"),\n\t8000,\n);\n\nconst highRiskRequest =\n\t/\\b(patient|medical|clinical|diagnosis|diagnostic|treatment|health records?|medical records?|legal advice|credit scoring|loan approval|insurance underwriting|employment decision|biometric|children|minor|safety-critical)\\b/i.test(\n\t\tsubmittedText,\n\t);\n\nconst containsImmediateTimeline =\n\t/\\b(asap|urgent|immediately|today|tomorrow|this week)\\b/i.test(submittedText);\n\nconst containsLongTermTimeline =\n\t/\\b(next year|long-term|research phase|no deadline|someday)\\b/i.test(\n\t\tsubmittedText,\n\t);\n\nconst conflictingTimeline =\n\tcontainsImmediateTimeline && containsLongTermTimeline;\n\nconst suspectedPromptInjection =\n\tsource.security?.suspected_prompt_injection === true;\n\nconst nearCategoryBoundary =\n\t!spamDetected &&\n\t[60, 80].some((boundary) => Math.abs(leadScore - boundary) <= 5);\n\nlet requiresHumanReview =\n\traw.requires_human_review === true ||\n\thighRiskRequest ||\n\tconflictingTimeline ||\n\tsuspectedPromptInjection ||\n\tconfidence < 70 ||\n\tnearCategoryBoundary;\n\nif (suspectedPromptInjection) {\n\tconfidence = Math.min(confidence, 60);\n\trequiresHumanReview = true;\n}\n\nif (highRiskRequest || conflictingTimeline) {\n\tconfidence = Math.min(confidence, 75);\n\trequiresHumanReview = true;\n}\n\nif (spamDetected && confidence < 85) {\n\trequiresHumanReview = true;\n}\n\nconst seenPainPoints = new Set();\n\nconst painPoints = (Array.isArray(raw.pain_points) ? raw.pain_points : [])\n\t.map((value) => cleanText(value, 200))\n\t.filter((value) => {\n\t\tif (!value) {\n\t\t\treturn false;\n\t\t}\n\n\t\tconst normalized = value.toLowerCase();\n\n\t\tif (seenPainPoints.has(normalized)) {\n\t\t\treturn false;\n\t\t}\n\n\t\tseenPainPoints.add(normalized);\n\t\treturn true;\n\t})\n\t.slice(0, 10);\n\nlet summaryReason = cleanText(raw.summary_reason, 300);\n\nif (!summaryReason) {\n\tsummaryReason = \"The automated assessment did not provide a usable summary.\";\n\n\trequiresHumanReview = true;\n}\n\nlet suggestedReply = spamDetected\n\t? \"No reply recommended.\"\n\t: limitWords(raw.suggested_reply, 150);\n\nif (!suggestedReply) {\n\tsuggestedReply = spamDetected\n\t\t? \"No reply recommended.\"\n\t\t: \"Thank you for reaching out. We would like to understand your requirements in more detail. Would you be available for a 15-minute discovery call?\";\n\n\trequiresHumanReview = true;\n}\n\nif (!spamDetected && !/\\b15[- ]minute\\b/i.test(suggestedReply)) {\n\tsuggestedReply = limitWords(\n\t\t`${suggestedReply} Would you be available for a 15-minute discovery call?`,\n\t\t150,\n\t);\n\n\trequiresHumanReview = true;\n}\n\nreturn [\n\t{\n\t\tjson: {\n\t\t\tsuccess: true,\n\t\t\tresult: {\n\t\t\t\tlead_score: leadScore,\n\t\t\t\tcategory,\n\t\t\t\tscore_breakdown: breakdown,\n\t\t\t\tspam_detected: spamDetected,\n\t\t\t\tsummary_reason: summaryReason,\n\t\t\t\tpain_points: painPoints,\n\t\t\t\tsuggested_reply: suggestedReply,\n\t\t\t\tconfidence,\n\t\t\t\trequires_human_review: requiresHumanReview,\n\t\t\t},\n\t\t\tmeta: {\n\t\t\t\trequest_id: source.request_id,\n\t\t\t\treceived_at: source.received_at,\n\t\t\t\tworkflow_version: \"1.1.0\",\n\t\t\t\tmodel_provider: \"Google Gemini\",\n\t\t\t\tautomated_assessment: true,\n\t\t\t},\n\t\t},\n\t},\n];\n"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
